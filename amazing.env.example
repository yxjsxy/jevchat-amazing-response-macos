# 私人配置路径：~/Library/Application Support/Jev Amazing/config/env
# 请自行填写，不要提交私人 env 文件。设置窗口保存后重新启动应用。
JUDGE_BACKEND=cloud
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://openrouter.ai/api/alpha/decisions
TYPESAFE_MODEL=typesafe/jev-1.13
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat-v3.1
JEV_HISTORY=0
JEV_CANDIDATES_PER_TONE=3
JEV_AMAZING_STRENGTH=1

# 图片/表情包理解，与生成Key/端点复用；也可配置独立视觉接口
JEV_VISION_MODEL=google/gemini-2.5-flash
# JEV_VISION_BASE_URL=https://openrouter.ai/api/v1
# JEV_VISION_API_KEY=
